# Hostinger (LiteSpeed/Apache)
Options -Indexes
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.mariossupersoil\.ca$ [NC]
RewriteRule ^ https://mariossupersoil.ca%{REQUEST_URI} [R=301,L]
# Old site URLs -> new pages (301 keeps Google rankings and old links working)
RewriteRule ^products/?$ /#products [R=301,NE,L]
RewriteRule ^worm-castings/?$ /products/worm-castings/ [R=301,L]
RewriteRule ^kelp-meal/?$ /products/kelp-meal/ [R=301,L]
RewriteRule ^level-up-organic-gardening/?$ /products/level-up/ [R=301,L]
RewriteRule ^flower-power-2-6-4/?$ /products/flower-power/ [R=301,L]
RewriteRule ^sustainable-fertilizers/?$ /guides/organic-soil-amendments-canada/ [R=301,L]
RewriteRule ^super-starter-pack/?$ /products/super-starter-pack/ [R=301,L]
RewriteRule ^marios-super-soil/?$ / [R=301,L]
RewriteRule ^(data|tools|\.git)(/|$) - [R=404,L]
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 week"
ExpiresByType application/javascript "access plus 1 week"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
